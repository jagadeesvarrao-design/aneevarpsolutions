# -----------------------------------------------------------------------------
# Aneevarp Solutions - Environment Variables Template
# -----------------------------------------------------------------------------
# Note: Never commit real credentials or production secrets to source control.
# Copy this file to .env and configure your production values.

# Server Configuration
PORT=4000
NODE_ENV=production

# Database Connection (PostgreSQL or SQLite for local dev)
DATABASE_URL="file:./dev.db"

# CORS Allowed Origins (Comma-separated or specific domains)
# Example: https://aneevarpsolutions.vercel.app,https://zenresume.online
CORS_ORIGIN="https://aneevarpsolutions.vercel.app"

# Administrative & Telemetry Sync Security Key (Minimum 32 random characters in production)
ADMIN_API_KEY="replace_with_a_secure_random_64_char_hex_key"
