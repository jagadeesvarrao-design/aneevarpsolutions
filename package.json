{
  "name": "aneevarp-solutions-backend",
  "version": "1.0.0",
  "description": "Backend engine and API service for Aneevarp Solutions parent holding company overseeing ZenResume, AI Job Search Agent, Press, Careers, IR, Governance, and Ecosystem Metrics.",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:push": "prisma db push",
    "db:seed": "ts-node-dev src/database/seed.ts",
    "db:studio": "prisma studio",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "keywords": [
    "aneevarp-solutions",
    "parent-company",
    "portfolio-backend",
    "holding-company",
    "api-engine"
  ],
  "author": "Aneevarp Solutions Tech Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
